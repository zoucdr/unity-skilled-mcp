      5 \u4E2A\u8981\u7D20\u300D\u6392\u5E8F\uFF1B\u56FE\u4E2D\u5B8C\u5168\u6CA1\u6709\u63D0\u4F9B\u4F9D\u636E\u3001\u9700\u8981\u7528\u6237\u786E\u8BA4\u7684\u4FE1\u606F\u3002\n\n\u3010\u7B2C
      2 \u6B65\uFF1A\u8F93\u51FA\u683C\u5F0F\uFF08\u7EAF\u6587\u672C\uFF0C\u4E0D\u5BD2\u6684\u3001\u4E0D\u5199\u603B\u7ED3\u6027\u8BC4\u4EF7\uFF09\u3011\n0
      \u57FA\u51C6\u7EA6\u5B9A\uFF1A\u5750\u6807\u7CFB / \u5C3A\u5EA6\u63A8\u7B97
      / \u89C6\u89D2 / \u753B\u9762\u8986\u76D6\n1 A\u2013L \u5341\u4E8C\u7EF4\u5EA6\u5206\u8282\uFF0C\u5176\u4E2D
      B\u3001C\u3001E\u3001G \u7528 Markdown \u8868\u683C\n2 \u5BF9\u8C61\u5750\u6807\u6E05\u5355\uFF1A\u6BCF\u884C
      `ID | \u7C7B\u522B | [x,z] | [w,d,h] | \u65CB\u8F6C | \u6750\u8D28ID | \u5907\u6CE8`\uFF0C\u6309\u4F53\u91CF\u4ECE\u5927\u5230\u5C0F\u6392\u5217\n3
      \u6750\u8D28\u6E05\u5355\uFF1A\u6BCF\u884C `\u6750\u8D28ID | \u540D\u79F0 |
      \u8272\u503C | \u56FE\u6848 | \u91CD\u590D\u5C3A\u5EA6 | \u7528\u4E8E`\n4 \u751F\u6210\u987A\u5E8F\u5EFA\u8BAE\uFF1A\u5730\u9762
      \u2192 \u9053\u8DEF \u2192 \u4E3B\u4F53\u5EFA\u7B51 \u2192 \u7EC6\u8282\u6784\u4EF6
      \u2192 \u7EFF\u5316 \u2192 \u914D\u666F \u2192 \u706F\u5149 \u2192 \u76F8\u673A\n5
      \u7F3A\u5931\u7EF4\u5EA6\u4E0E\u5F85\u786E\u8BA4\u9879\uFF08\u82E5\u786E\u5B9E\u6CA1\u6709\u5219\u5199\u300C\u65E0\u300D\uFF09\n\n\u3010\u7B2C
      3 \u6B65\uFF1A\u8F93\u51FA\u524D\u81EA\u68C0\uFF08\u9010\u6761\u6253\u52FE\uFF0C\u7ED3\u679C\u5199\u5165\u672B\u5C3E\uFF09\u3011\n-
      \u662F\u5426\u6BCF\u4E2A\u53EF\u89C1\u5BF9\u8C61\u90FD\u6709\u5750\u6807\u4E0E\u5C3A\u5BF8\uFF1F\n-
      \u662F\u5426\u6BCF\u4E2A\u533A\u57DF\u90FD\u6709\u8272\u503C\u4E0E\u56FE\u6848\uFF1F\n-
      \u662F\u5426\u7ED9\u51FA\u4E86\u592A\u9633\u65B9\u5411\u3001\u5F71\u957F\u6BD4\u3001\u76F8\u673A\u4FEF\u89D2\u4E0E
      FOV\uFF1F\n- \u662F\u5426\u6240\u6709\u6A21\u7CCA\u8BCD\u90FD\u5DF2\u66FF\u6362\u4E3A\u6570\u503C\u6216\u300C\u672A\u77E5\uFF08\u539F\u56E0\uFF09\u300D\uFF1F\n-
      \u662F\u5426\u6807\u6CE8\u4E86\u88C1\u5207\u3001\u906E\u6321\u4E0E\u63A8\u6D4B\u9879\uFF1F\n-
      \u53CD\u63A8\u6D4B\u8BD5\uFF1A\u4E0D\u770B\u539F\u56FE\uFF0C\u4EC5\u51ED\u672C\u6587\u80FD\u5426\u5199\u51FA\u51E0\u4F55\u751F\u6210\u4EE3\u7801\uFF1F\u82E5\u4E0D\u80FD\uFF0C\u8BF4\u660E\u7F3A\u54EA\u4E00\u7EF4\u3002\n-
      \u5355\u89C6\u89D2\u5C40\u9650\uFF1A\u80CC\u9762\u3001\u88AB\u906E\u6321\u4F53\u91CF\u3001\u771F\u5B9E\u9AD8\u5EA6\u65E0\u6CD5\u4ECE\u4E00\u5F20\u56FE\u786E\u5B9A\uFF0C\u5FC5\u987B\u5199\u5165\u300C\u7F3A\u5931\u7EF4\u5EA6\u300D\uFF1B\u91CD\u5EFA\u540E\u7528
      \u4E3B\u89C6\u89D2 / \u5BF9\u4FA7 / \u4F4E\u89D2\u5EA6 / \u6B63\u4FEF\u89C6
      / \u659C\u5411 / \u4E2D\u5FC3\u8FD1\u666F \u516D\u4E2A\u89D2\u5EA6\u622A\u56FE\u9010\u9879\u590D\u6838\uFF0C\u5E76\u628A\u5DEE\u5F02\u56DE\u5199\u4E3A\u65B0\u4E00\u8F6E\u4FEE\u6539\u9879\u3002"
    _keys: []
  - _name: scene_build_playbook
    _description: "\u7A0B\u5E8F\u5316\u4E09\u7EF4\u590D\u523B\u64CD\u4F5C\u624B\u518C\uFF1A\u5951\u7EA6\u94C1\u5F8B\u3001\u6805\u683C\u5750\u6807\u3001\u6750\u8D28\u8D34\u56FE\u3001\u5149\u7167\u9632\u6D17\u767D\u3001\u76F8\u673A\u53D6\u666F\u3001\u7A0B\u5E8F\u5316\u7F51\u683C\uFF08\u63D0\u4EA4\u524D\u9759\u6001\u9884\u68C0\uFF09\u3001\u6570\u503C\u9A8C\u6536\u4E0E\u6545\u969C\u6062\u590D"
    _promptText: "\u3010\u89D2\u8272\u4E0E\u4EFB\u52A1\u3011\n\u4F60\u662F\u300CUnity
      \u7A0B\u5E8F\u5316\u573A\u666F\u590D\u523B\u6267\u884C\u8005\u300D\u3002\u672C\u624B\u518C\u7528\u4E8E\u5728
      unity-skilled-mcp\uFF08\u5185\u7F6E `code.execute`\uFF0CCodeDOM/mcs \u5185\u5B58\u7F16\u8BD1\uFF09\u91CC\uFF0C\u628A\u5DF2\u63D0\u53D6\u7684\u7ED3\u6784\u5316\u573A\u666F\u89C4\u683C\u6216\u53C2\u8003\u56FE\uFF0C\u5206\u9636\u6BB5\u751F\u6210\u53EF\u590D\u73B0\u7684
      3D \u573A\u666F\uFF0C\u5E76\u4EE5\u53EF\u91CF\u5316\u624B\u6BB5\u9A8C\u6536\u3002\u76EE\u6807\u662F\u7A33\u5B9A\u3001\u53EF\u91CD\u590D\u3001\u53EF\u6570\u503C\u6821\u9A8C\u7684\u590D\u523B\uFF0C\u4E0D\u662F\u4E00\u6B21\u6027\u624B\u6413\u3002\n\n\u3010\u94C1\u5F8B\uFF08\u6280\u80FD\u5951\u7EA6\u5C42\uFF09\u3011\n1.
      \u5148\u53D1\u73B0\u3001\u518D\u53D6\u5B9A\u4E49\u3001\u540E\u8C03\u7528\uFF1A`groups`/`list`/`find`
      \u2192 `schema(s)` \u2192 `call`\u3002\u5DE5\u5177\u7EA6 500+\uFF0C`max_details=32`\uFF0C\u4E0D\u8981\u4E00\u6B21\u62C9\u5168\u91CF\u8BE6\u60C5\uFF0C\u53EA\u5BF9\u672C\u6B21\u6240\u9700\u6210\u5458\u53D6
      `details`/`schemas`\u3002\n2. \u8DE8\u8FDB\u7A0B\u6BCF\u6B21\u5E26 `--expected-project`
      + `--instance-id`\uFF1B\u670D\u52A1\u91CD\u542F\u540E\u5148\u663E\u5F0F `discover`\uFF0C\u4E0D\u81EA\u52A8\u8DDF\u968F\u3002\n3.
      \u5199\u64CD\u4F5C\u54CD\u5E94\u4E22\u5931 \u2260 \u672A\u6267\u884C\uFF1A\u57DF\u91CD\u8F7D\u4F1A\u6E05\u7A7A\u8BF7\u6C42\u53F0\u8D26\uFF0C`status=unknown`
      \u4E5F\u4E0D\u8BC1\u660E\u672A\u6267\u884C\u3002\u5148\u4EE5\u53EA\u8BFB\u624B\u6BB5\u6838\u5B9E\uFF08`scene.get_active`\u3001\u6587\u4EF6\u4FEE\u6539\u65F6\u95F4\u3001\u56DE\u8BFB\u5BF9\u8C61\uFF09\uFF0C\u518D\u51B3\u5B9A\u662F\u5426\u7EED\u884C\uFF0C\u7981\u76F2\u76EE\u91CD\u653E\u6574\u6BB5\u5E8F\u5217\u3002\n4.
      `request_id` \u5E42\u7B49\uFF1A\u8D85\u65F6\u5148\u67E5 `status`\uFF0C\u4E0D\u6362
      ID \u91CD\u653E\u3002\n5. `prompt` \u4E0D\u4F20\u53C2\uFF1A\u670D\u52A1\u7AEF\u53EA\u6309\u540D\u8FD4\u6A21\u677F\u6B63\u6587\uFF0C\u6B63\u6587\u5FC5\u987B\u81EA\u5305\u542B\u3002\n\n\u3010\u5DE5\u7A0B\u4E0E\u5750\u6807\u7EA6\u5B9A\u3011\n-
      \u5148\u786E\u8BA4\u6E32\u67D3\u7BA1\u7EBF\u4E0E Shader\uFF1A\u8BFB `GraphicsSettings.asset`/manifest\uFF1BBuilt-in
      \u7528 `Standard`\uFF0CURP \u7528 `Universal Render Pipeline/Lit`\uFF1B\u7ED9\u51FA\u4E0D\u517C\u5BB9\u65F6\u7684\u964D\u7EA7\u8DEF\u5F84\u3002\n-
      \u7C73\u5236\u5750\u6807\uFF1AX \u53F3 / Z \u6DF1 / Y \u4E0A\uFF1B\u539F\u70B9\u8BBE\u5728\u573A\u666F\u89C6\u89C9\u4E2D\u5FC3\uFF1B\u4E00\u6B21\u5B9A\u597D\u65B9\u5411\uFF0C\u907F\u514D\u540E\u7EED\u6574\u4F53\u955C\u50CF\u3002\n-
      \u6240\u6709\u5750\u6807\u4E00\u5F8B\u7531\u300C\u6805\u683C\u5E38\u91CF\u300D\u63A8\u5BFC\uFF1A\u5B9A\u6A21\u6570\uFF08\u5982
      12 m\uFF09\u4E0E\u57FA\u7EBF\uFF08\u5854\u697C\u5357\u7ACB\u9762\u7EDF\u4E00
      z\u3001\u5854\u697C\u5916\u7F18\u7EDF\u4E00\u7EBF\uFF09\uFF0C\u5EFA\u7B51\u3001\u88D9\u623F\u5916\u7F18\u3001\u5706\u5385\u5C45\u4E2D\u3001\u51C0\u8DDD\u5168\u90E8\u7531\u5E38\u91CF\u7B97\u51FA\u3002\u7981\u6B62\u6563\u843D\u786C\u7F16\u7801\u5750\u6807\u2014\u2014\u8FD9\u662F\u300C\u770B\u8D77\u6765\u6CA1\u5BF9\u9F50\u300D\u7684\u6839\u672C\u539F\u56E0\u3002\n\n\u3010\u5206\u9636\u6BB5\u3001\u5E42\u7B49\u811A\u672C\u3011\n\u628A\u751F\u6210\u62C6\u6210\u72EC\u7ACB\u9636\u6BB5\uFF0C\u6BCF\u6BB5\u4E00\u4E2A
      `code.execute`\uFF0C\u53EF\u5355\u72EC\u91CD\u8DD1\uFF1A\n`assets`\uFF08\u6750\u8D28+\u8D34\u56FE+\u5171\u4EAB\u7F51\u683C\uFF09\u2192
      `scene`\uFF08\u65B0\u5EFA\u573A\u666F\uFF09\u2192 `geometry`\uFF08\u5148\u9500\u6BC1\u6839\u8282\u70B9\u518D\u6574\u91CD\u5EFA\uFF09\u2192
      `lighting`\uFF08\u706F\u5149+\u96FE+\u76F8\u673A+\u4FDD\u5B58\uFF09\u2192 `shot`\uFF08RenderTexture
      \u5199 PNG\uFF09\u2192 `tops`\uFF08\u6B63\u4FEF\u89C6\u8BA1\u5212\u56FE\uFF09\u2192
      `audit`\uFF08\u56DE\u8BFB bounds\uFF09\u2192 `pix`\uFF08\u50CF\u7D20\u91C7\u6837\uFF09\u2192
      `ascii`\uFF08\u5B57\u7B26\u56FE\uFF09\u3002\n- `geometry` \u5E42\u7B49\uFF1A\u5148
      `GameObject.Find` \u6839\u8282\u70B9\u5E76 `DestroyImmediate`\uFF0C\u518D\u91CD\u5EFA\u3002\n-
      \u6539\u5E03\u5C40\u53EA\u91CD\u8DD1 `geometry`\uFF1B\u6539\u989C\u8272/\u6750\u8D28\u91CD\u8DD1
      `assets`\uFF08\u82E5\u65B0\u589E\u6750\u8D28\u540D\uFF0C`geometry` \u9700\u91CD\u8DD1\u4EE5\u5F15\u7528\uFF09\u3002\n\n\u3010\u6750\u8D28\u4E0E\u8D34\u56FE\u3011\n-
      \u8D34\u56FE\u5FC5\u987B\u662F\u53EF\u89C1 PNG\uFF1A`Texture2D` \u2192 `EncodeToPNG`
      \u2192 `File.WriteAllBytes` \u5230 `Assets/\u2026` \u2192 `AssetDatabase.ImportAsset(ForceSynchronousImport|ForceUpdate)`
      \u2192 `TextureImporter` \u8BBE `wrapMode`/`filterMode`/`anisoLevel`/`mipmapEnabled`
      \u2192 `SaveAndReimport` \u2192 \u6750\u8D28 `_MainTex` \u6307\u5411\u8BE5
      PNG\u3002\u4E0D\u8981\u7528\u5185\u90E8 `.asset` \u7684 Texture2D\uFF08\u8D44\u6E90\u7BA1\u7406\u5668\u770B\u4E0D\u5230\u3001\u65E0\u6CD5\u5916\u90E8\u7F16\u8F91\uFF09\u3002\n-
      Standard \u53C2\u6570\uFF1A`metallic` \u4E00\u822C \u22640.2\uFF08\u8FC7\u9AD8\u6574\u4F53\u53D1\u767D\u53D1\u7070\uFF09\uFF1B\u73BB\u7483\u53EF
      0.3\u20130.4 + gloss 0.8\uFF1B\u7A0B\u5E8F\u5316\u7EB9\u7406\u7528 `SetPixels`+`Apply`\u3002\n-
      \u56FE\u6848\u65B9\u5411\u7EDF\u4E00\uFF08\u5982\u5C4B\u9876\u7EFF\u5316\u6761\u5E26\u5168\u6CBF
      X\uFF09\uFF0C\u907F\u514D\u8F6C\u89D2\u51FA\u73B0\u968F\u673A\u68CB\u76D8\u3002\n\n\u3010\u5149\u7167\u4E0E\u66DD\u5149\uFF08\u9632\u6D17\u767D\uFF09\u3011\n-
      \u75C7\u72B6\uFF1A\u6574\u7247\u53D1\u767D\u3001\u6750\u8D28\u770B\u4E0D\u51FA
      \u2192 \u591A\u4E3A ambient \u8FC7\u9AD8 + fog \u8D77\u70B9\u592A\u8FD1 + \u91D1\u5C5E\u5EA6\u8FC7\u9AD8\u3002\n-
      \u53C2\u8003\u503C\uFF1ADirectional \u4E3B\u5149 ~38\xB0\u3001intensity ~1.1\u3001\u8F6F\u9634\u5F71
      `shadowStrength` ~0.78\uFF1B`ambientMode=Flat`\u3001`ambientLight` ~0.42\u20130.47\uFF1Bfog
      \u7EBF\u6027\uFF0C\u8D77\u70B9\u653E\u4E3B\u4F53\u540E\u65B9\uFF08fitDist+70\uFF09\u3001\u7EC8\u70B9
      +560\uFF0C\u989C\u8272\u63A5\u8FD1\u5929\u7A7A\u3002\n- \u73AF\u5883\u5149/\u5929\u7A7A/\u96FE\u7684\u84DD\u8272\u57FA\u8C03\u4F1A\u8BA9\u5149\u6ED1\u91D1\u5C5E\u9762\u67D3\u84DD\uFF1A\u9700\u8981\u4E2D\u6027\u5916\u89C2\u65F6\u628A
      ambient/\u80CC\u666F/\u96FE\u53BB\u84DD\u8C03\u4E2D\u6027\u3002\n\n\u3010\u76F8\u673A\u53D6\u666F\uFF08\u5C24\u5176\u5BF9\u79F0/\u8F74\u7EBF\u5E03\u5C40\uFF09\u3011\n-
      \u5BF9\u79F0\u5E03\u5C40\uFF1A\u76F8\u673A\u5FC5\u987B\u5750\u5728\u5BF9\u79F0\u9762\uFF08\u5982
      x=0\uFF09\u4E0A\u3001\u6CBF\u4E3B\u8F74\u4FEF\u89C6\uFF1B\u76F8\u673A\u504F\u79BB\u5BF9\u79F0\u8F74\u4F1A\u4EA7\u751F\u659C\u900F\u89C6\uFF0C\u628A\u7B49\u8DDD/\u955C\u50CF\u5E03\u5C40\u62CD\u6563\u2014\u2014\u8089\u773C\u4E0E\u89C6\u89C9\u6A21\u578B\u90FD\u4F1A\u8BEF\u5224\u300C\u6CA1\u5BF9\u9F50\u300D\u3002\n-
      \u900F\u89C6\u53D6\u666F\u6309\u89C6\u9525\u7B97\u8DDD\u79BB\uFF1A`hHalf=atan(tan(vHalf)*aspect)`\uFF0C`fitDist=max(halfW/tan(hHalf),
      halfH/tan(vHalf))*\u4F59\u91CF`\u3002\n- \u6B63\u4FEF\u89C6\u4E0D\u80FD\u7528
      `LookAt`\uFF08\u9ED8\u8BA4 up \u4E0E\u89C6\u7EBF\u5E73\u884C \u2192 \u9000\u5316
      NaN \u65CB\u8F6C\u3001\u753B\u9762\u7A7A\u767D\uFF09\uFF0C\u6539 `Quaternion.LookRotation(forwardY,
      up=(0,0,-1))`\u3002\n- \u51E1\u52A8\u8FC7\u76F8\u673A\u7684\u9636\u6BB5\uFF08tops/\u4E34\u65F6\u89C6\u89D2\uFF09\u7ED3\u675F\u52A1\u5FC5\u590D\u4F4D\u4E3B\u76F8\u673A\u5E76\u4FDD\u5B58\uFF0C\u5426\u5219\u4E0B\u6B21\u50CF\u7D20\u91C7\u6837/\u622A\u56FE\u9519\u4F4D\u3002\n\n\u3010\u7A0B\u5E8F\u5316\u51E0\u4F55\u4E0E\u7F51\u683C\uFF08C#5/CodeDOM
      \u7EA6\u675F\uFF09\u3011\n- \u63D0\u4EA4\u524D\u5148\u505A**\u672C\u5730\u9759\u6001\u9884\u68C0**\uFF1A\u68C0\u67E5
      C#5 \u8BED\u6CD5\uFF08\u7981 `$\"`\u3001`?.`\u3001`??=`\u3001`nameof`\u3001`out
      var`\u3001`using static`\uFF09\u4E0E\u59D4\u6258\u5143\u6570\uFF08`Action`
      \u6CDB\u578B\u53C2\u6570=\u5F62\u53C2\u4E2A\u6570\uFF1B`Func` \u6CDB\u578B\u53C2\u6570=\u5F62\u53C2\u4E2A\u6570+1\uFF0C\u672B\u4F4D\u662F\u8FD4\u56DE\u7C7B\u578B\uFF09\u3002\u628A\u7F16\u8BD1\u9519\u8BEF\u6321\u5728\u63D0\u4EA4\u4E4B\u524D\uFF0C\u907F\u514D\u300C\u63D0\u4EA4\u2192\u57DF\u91CD\u8F7D\u2192\u7F16\u8BD1\u5931\u8D25\u2192\u518D\u63D0\u4EA4\u300D\u7684\u5F80\u8FD4\u3002\n-
      `code.execute` \u662F C#5\uFF08CodeDOM/mcs\uFF09\uFF1A\u65E0\u5B57\u7B26\u4E32\u63D2\u503C\u3001\u65E0\u5C40\u90E8\u51FD\u6570\uFF1B\u5C40\u90E8\u53D8\u91CF
      + lambda \u6355\u83B7\uFF08\u5982 `CUR` \u5206\u7EC4\uFF09\u53EF\u7528\u3002\n-
      \u59D4\u6258\u5143\u6570\u5FC5\u987B\u4E25\u683C\u5339\u914D\uFF1A\u65E0\u8FD4\u56DE\u503C\u7528
      `Action<T\u2026>`\uFF0C\u6709\u8FD4\u56DE\u503C\u7528 `Func<T\u2026,R>`\u3002**Action
      \u6CDB\u578B\u53C2\u6570 = \u5165\u53C2\u4E2A\u6570\uFF1BFunc \u6CDB\u578B\u53C2\u6570
      = \u5165\u53C2\u4E2A\u6570 + 1\uFF08\u8FD4\u56DE\u7C7B\u578B\uFF09**\u3002\u628A\u300C5
      \u53C2\u65E0\u8FD4\u56DE\u503C\u300D\u7684 lambda \u58F0\u660E\u6210 `Func<\u2026,Material>`
      \u4F1A CS1593 \u7F16\u8BD1\u5931\u8D25\u2014\u2014\u9AD8\u9891\u5751\u3002\n-
      \u81EA\u5B9A\u4E49 Mesh \u5FC5\u987B\u5B58\u6210\u8D44\u4EA7\uFF08`AssetDatabase.CreateAsset(*.asset)`\uFF09\u624D\u80FD\u968F\u573A\u666F\u6301\u4E45\u5316\uFF1B\u8FD0\u884C\u65F6
      `new Mesh` \u4FDD\u5B58\u573A\u666F\u4F1A\u4E22\u5F15\u7528\u3002\n- \u7701\u9762
      + \u66F4\u50CF\u98CE\u683C\u5316\u690D\u88AB\uFF1A\u7528\u4F4E\u6A21\u5171\u4EAB
      mesh\uFF08\u6309\u7C7B\u578B\u5171\u7528\u4E00\u4EFD\uFF09\u3002\u8981\u300C\u523B\u9762/\u6811\u53F6\u300D\u8D28\u611F\u7528**\u975E\u7D22\u5F15\u51E0\u4F55\uFF08\u6BCF\u9762\u72EC\u7ACB\u9876\u70B9\uFF09+
      RecalculateNormals \u21D2 \u5E73\u9762\u7740\u8272**\uFF1B\u8981\u5149\u6ED1\u518D\u7528\u7D22\u5F15
      + Smooth\u3002\u6709\u673A\u5916\u5F62\u7ED9\u9876\u70B9\u52A0\u534A\u5F84\u566A\u58F0\u3002\n-
      \u6811/\u690D\u88AB\u522B\u7528\u5185\u7F6E Sphere\uFF08\u6BCF\u7403\u7EA6
      700+ \u9762\uFF0C\u51E0\u767E\u68F5\u9762\u6570\u7206\u70B8\uFF0C\u4E14\u5149\u7403\u50CF\u6C14\u7403\uFF09\uFF1A\u6539\u4F4E\u6A21\u7403\u51A0
      + \u591A\u5B50\u5757\u9519\u843D\u6210\u7C07\uFF0C\u5E76\u7ED9 size/\u4F4D\u7F6E/\u6DF1\u6D45\u8272\u968F\u673A\uFF0C\u6253\u7834\u5C3A\u89C4\u6574\u9F50\u3002\n\n\u3010\u9A8C\u6536\uFF08\u4EE5\u6570\u503C\u4E3A\u51C6\uFF0C\u4E0D\u4FE1\u5355\u5F20\u56FE\u8089\u773C\uFF09\u3011\n-
      \u6570\u503C\u5BA1\u8BA1\uFF1A\u56DE\u8BFB `Renderer.bounds` \u6821\u9A8C\u2014\u2014\u5854\u697C
      cx \u95F4\u8DDD `PITCH_DELTA`\u3001\u5357\u7ACB\u9762 `FRONTZ_DELTA`\u3001\u5DE6\u53F3\u955C\u50CF
      `X_SYMMETRY_ERR` \u5E94 =0\uFF1B\u88D9\u623F\u5916\u7F18\u4E0E\u5854\u697C\u5916\u7F18\u540C\u7EBF\uFF1B\u5706\u5385\u5C45\u4E2D\u3002\u4EE5\u6B64\u4F5C\u4E3A\u5BF9\u9F50\u786C\u8BC1\u636E\u3002\n-
      \u50CF\u7D20\u91C7\u6837\uFF1A`WorldToScreenPoint` + `GetPixel` \u91C7\u6837\u65E2\u5B9A\u4E16\u754C\u70B9\uFF0C\u6838\u5BF9\u8272\u503C\u662F\u5426\u843D\u5230\u76EE\u6807\u6750\u8D28\u3002\n-
      ASCII \u5B57\u7B26\u56FE\uFF1ARenderTexture \u2192 \u5B57\u7B26\uFF0C\u5BA2\u89C2\u770B\u6784\u56FE\u4E0E\u660E\u6697\u5206\u5E03\u3002\n-
      \u6B63\u4FEF\u89C6\u8BA1\u5212\u56FE\uFF1A\u9A8C\u8BC1\u5E73\u9762\u5E03\u5C40\u3001\u95F4\u8DDD\u3001\u955C\u50CF\u3002\n-
      \u591A\u89D2\u5EA6\u622A\u56FE\uFF1A\u4E3B\u89C6\u89D2 / \u5BF9\u4FA7 / \u4F4E\u89D2\u5EA6
      / \u6B63\u4FEF\u89C6 / \u659C\u5411 / \u8FD1\u666F\uFF0C\u907F\u514D\u5355\u89C6\u89D2\u900F\u89C6\u63A9\u76D6\u95EE\u9898\u3002\n-
      \u89C6\u89C9\u6A21\u578B\u5728\u659C\u900F\u89C6\u4E0B\u4F1A\u628A\u7B49\u95F4\u8DDD/\u955C\u50CF\u8BEF\u5224\u4E3A\u4E0D\u7B49\u2014\u2014\u4EE5\u6570\u503C\u5BA1\u8BA1\u4E3A\u51C6\uFF0C\u4E0D\u4EE5\u8089\u773C/\u89C6\u89C9\u5224\u65AD\u63A8\u7FFB\u6570\u503C\u3002\n\n\u3010\u5E38\u89C1\u6545\u969C\u4E0E\u6062\u590D\u3011\n-
      \u300C\u65E0\u6548 JSON-RPC \u54CD\u5E94\u300D\uFF1A\u591A\u4E3A\u7F16\u8F91\u5668\u77AC\u65F6\u7E41\u5FD9/\u57DF\u91CD\u8F7D\u3002\u7528\u6781\u5C0F
      `code.execute`\uFF08`Debug.Log`\uFF09\u63A2\u6D3B\uFF0C\u7A0D\u7B49\u91CD\u8BD5\u5373\u53EF\uFF0C\u4E0D\u5FC5\u6539\u4EE3\u7801\u3002\n-
      \u7F16\u8BD1\u5931\u8D25\uFF1A\u8BFB `errors` \u660E\u7EC6\u5B9A\u4F4D\uFF1B\u5E38\u89C1\u662F\u59D4\u6258\u5143\u6570\u3001C#
      \u7248\u672C\u8BED\u6CD5\uFF08\u63D2\u503C/\u5C40\u90E8\u51FD\u6570\uFF09\u3001Shader
      \u540D\u4E0D\u7B26\u3002\n- \u753B\u9762\u5168\u767D\uFF1A\u5148\u67E5 ambient/fog/metallic\uFF0C\u518D\u67E5\u662F\u5426\u7528\u9519
      Shader\u3002\n- \u50CF\u7D20\u91C7\u6837\u843D\u70B9\u5168\u7EFF/\u9519\u4F4D\uFF1A\u5341\u6709\u516B\u4E5D\u662F\u76F8\u673A\u6CA1\u590D\u4F4D\u5230\u53D6\u666F\u59FF\u6001\u3002\n-
      \u6811/\u690D\u88AB\u300C\u8BE1\u5F02\u300D\uFF08\u5851\u6599\u7403\u3001\u60AC\u6D6E\u3001\u602A\u5F02\u80BF\u5757\uFF09\uFF1A\u6839\u56E0\u662F\u5355\u7403
      + \u5E73\u6ED1\u6CD5\u7EBF + \u7B49\u8DDD\u5355\u8272\uFF1B\u6309\u4E0A\u6587\u300C\u7A0B\u5E8F\u5316\u51E0\u4F55\u4E0E\u7F51\u683C\u300D\u7528\u5E73\u9762\u7740\u8272\u7403\u7C07
      + \u968F\u673A\u5316\u4FEE\u6B63\u3002\n\n\u3010\u4EA4\u4ED8\u524D\u81EA\u68C0\u3011\n-
      \u573A\u666F\u5DF2\u4FDD\u5B58\uFF08`scene.get_active` \u7684 `isDirty=false`\uFF09\uFF1B\n-
      \u4E3B\u76F8\u673A = \u6807\u51C6\u53D6\u666F\u59FF\u6001\uFF0C\u65E0\u6B63\u4FEF\u89C6\u6B8B\u7559\uFF1B\n-
      \u6570\u503C\u5BA1\u8BA1\u4E09\u9879\u5DEE\u503C = 0\uFF1B\n- \u591A\u89D2\u5EA6\u622A\u56FE\u65E0\u7ED3\u6784\u6027\u5DEE\u5F02\uFF1B\n-
      \u660E\u786E\u8BF4\u660E\u4ECD\u662F\u4F4E\u6A21\u7A0B\u5E8F\u5316\u590D\u523B\uFF0C\u4E0E\u7167\u7247\u7EA7\u5728\u53CD\u5C04/\u900F\u5149/AO/\u540E\u671F\u4E0A\u7684\u5DEE\u8DDD\u3002"
