{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/unity-ugui/ui_spec.schema.json",
  "title": "UI Spec v1.0 — 效果图到 UGUI 的唯一真值源",
  "description": "所有坐标用 rect=[left,top,width,height]（效果图左上原点、像素、y 向下），由 coords.js 单点换算到 UGUI / UISourceGen / Sprite 裁切。工具名与工程绝对路径不得写入 Spec。",
  "type": "object",
  "required": ["spec_version", "name", "source", "nodes"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string", "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "description": "界面名，同时决定 Unity 根对象 UGUI_<name> 与产物目录" },
    "source": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "description": "效果图路径，工程内相对路径或绝对路径" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_resolution": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "scale_mode": { "type": "string", "enum": ["ScaleWithScreenSize", "ConstantPixelSize"] },
        "match": { "type": "number", "minimum": 0, "maximum": 1 },
        "root": { "type": "string" },
        "sorting_order": { "type": "integer" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string" }, "primary_end": { "type": "string" },
        "surface": { "type": "string" }, "surface_end": { "type": "string" },
        "on_surface": { "type": "string" }, "border": { "type": "string" },
        "background": { "type": "string" },
        "radius": { "type": "number" }, "font_size": { "type": "integer" },
        "font_path": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": { "type": "string" }, "field": { "type": "string" },
          "reason": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type", "rect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "稳定唯一 id；同时作为切图文件名与 ui_rule 节点 id" },
        "name": { "type": "string", "description": "Unity GameObject 名；缺省用 id" },
        "origin_name": { "type": "string", "description": "效果图/Figma 里的原始节点名" },
        "parent": { "type": ["string", "null"], "description": "父节点 id；与 children 二选一" },
        "children": { "type": "array", "items": { "$ref": "#/definitions/node" } },
        "type": {
          "type": "string",
          "enum": ["canvas", "panel", "card", "image", "icon", "divider", "label", "button",
                   "toggle", "slider", "input", "progress", "scroll", "dropdown", "badge", "tab", "group"]
        },
        "rect": {
          "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
          "description": "[left, top, width, height]，效果图左上原点、y 向下、像素"
        },
        "anchor": {
          "type": "string",
          "enum": ["top_left", "top_center", "top_right", "middle_left", "middle_center",
                   "middle_right", "bottom_left", "bottom_center", "bottom_right",
                   "stretch_horizontal", "stretch_vertical", "stretch"],
          "default": "middle_center"
        },
        "asset": { "type": "string", "enum": ["crop", "regenerate", "external", "none"], "default": "crop" },
        "asset_path": { "type": "string", "description": "asset=external 时必填" },
        "slice": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 4, "maxItems": 4, "default": [0, 0, 0, 0], "description": "九宫格 [left,top,right,bottom]，写进 TextureImporter.spriteBorder" },
        "states": { "type": "array", "items": { "type": "string", "enum": ["normal", "hover", "pressed", "disabled", "selected", "checked"] } },
        "text": { "type": "string" },
        "icon": { "type": "string" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "checked": { "type": "boolean" },
        "items": { "type": "array", "items": { "type": "string" } },
        "font_size": { "type": "integer", "minimum": 1 },
        "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3,8})$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "visible": { "type": "boolean", "default": true },
        "interactive": { "type": "boolean", "default": false },
        "order": { "type": "integer" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "type": "string" }, "background_end": { "type": "string" },
            "corner_radius": { "type": "number" }, "border_color": { "type": "string" },
            "border_width": { "type": "number" }, "text_align": { "type": "string" },
            "placeholder": { "type": "string" }, "surface": { "type": "string" }
          }
        }
      }
    }
  }
}
